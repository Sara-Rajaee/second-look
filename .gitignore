*.o
*.e

# data
*.json
*.jsonl 
*.pdf
!data/*.json
data/
# bash files with API tokens (but not scripts/)
/*.sh
*.csv
# Track the generated plots at any depth (heatmaps nest as {task}/{model}/*.png),
# but nothing else under outputs/. The directory re-include is required: git will
# not descend into an excluded directory, so `!outputs/**/*.png` alone never matches.
outputs/**
!outputs/**/
!outputs/**/*.png

*.pyc

# playground files
tmp.py
analysis.py
comet_eval.py

# logs and results
logs/
results/
train_runs/

# claude code
.claude/

# virtual environment
.venv/

# node-local install config (see configs/derive_paths.sh)
configs/local/*.env
configs/.node_envs/

# environment
.env

# uv
uv.lock

# cache
__pycache__/
.cache/

build/*
src/lingo_reason.egg-info/*