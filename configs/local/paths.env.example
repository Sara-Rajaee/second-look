# configs/local/paths.env.example
# Copy to paths.env and set this to a directory on fast local/node storage
# (not a quota-limited shared path). Everything else derives from this,
# including a one-time `.venv` install into SHARED (see derive_paths.sh).

SHARED=/scratch/$USER/second_look_shared  # choose your base directory instead <---

# Python entrypoint for dev/analysis commands.
# derive_paths.sh installs .venv into $SHARED, so this is normally:
PYTHON=$SHARED/.venv/bin/python
